---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects';
---

<Layout
  title="Maxence Coste — Développeur Front-End"
  description="Portfolio de Maxence Coste, développeur front-end à la recherche d'un stage en développement web de 3 mois dès avril 2027."
>
  <main>
    <section class="hero" aria-label="Présentation">
      <!-- Arrière-plan ambiant monochrome pour révéler l'effet Liquid Glass -->
      <div class="hero-ambient" aria-hidden="true">
        <div class="ambient-grid"></div>
        <div class="ambient-orb ambient-orb-left"></div>
        <div class="ambient-orb ambient-orb-right"></div>
      </div>

      <div class="hero-inner">
        <!-- Scène principale -->
        <div class="hero-stage">
          <div class="hero-grid">
            <!-- Gauche : Photo portrait -->
            <div class="photo-column">
              <div class="photo-frame">
                <img
                  src="/photo.jpg"
                  alt="Portrait de Maxence Coste"
                  class="portrait-photo"
                />
              </div>
            </div>

            <!-- Droite : Titre, sous-titre et liens -->
            <div class="content-column">
              <h1 class="hero-title">
                <span>MAXENCE</span>
                <span>COSTE</span>
              </h1>

              <p class="role-label">Développeur Front-End</p>

              <p class="hero-description">
                Recherche d'un stage en développement web de 3 mois<br />
                dès avril 2027
              </p>

              <nav class="hero-links" aria-label="Liens et contact">
                <a
                  href="https://www.linkedin.com/in/maxence-c-62aaa0264/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="icon-link"
                  aria-label="LinkedIn"
                  title="LinkedIn"
                >
                  <svg
                    class="social-icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"
                    />
                  </svg>
                </a>

                <button
                  type="button"
                  class="email-link"
                  id="copy-email"
                  data-email="maxence.coste.mc@gmail.com"
                  aria-label="Copier l'adresse email maxence.coste.mc@gmail.com"
                >
                  <span>maxence.coste.mc@gmail.com</span>
                  <span class="copy-feedback" aria-live="polite">Copié !</span>
                </button>
              </nav>
            </div>
          </div>

          <!-- Zone inférieure : flèche centrée -->
          <div class="hero-bottom">
            <a
              href="#decouvrir"
              class="scroll-chevrons"
              aria-label="Descendre pour découvrir la suite"
            >
              <svg
                class="chevron-icon"
                viewBox="0 0 26 15"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 3L13 12L23 3"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section Projets -->
    <section id="decouvrir" class="projects-section" aria-label="Projets">
      <div class="projects-ambient" aria-hidden="true">
        <div class="ambient-grid"></div>
        <div class="ambient-orb ambient-orb-projects-left"></div>
        <div class="ambient-orb ambient-orb-projects-right"></div>
      </div>

      <div class="projects-inner">
        <div class="projects-stage">
          <header class="projects-header reveal-item">
            <h2 class="section-title">Projets</h2>
          </header>

          <div class="projects-grid">
            {
              projects.map((project) => (
                <article class="project-card liquid-glass">
                  <div class="project-card-body">
                    <div class="project-preview">
                      <div class="project-preview-meta">
                        <span class="project-number">{project.number}</span>
                        <span class="project-year">{project.context}</span>
                      </div>
                      <a
                        href={`/projets/${project.slug}`}
                        class="project-preview-media"
                        aria-label={`Découvrir le projet ${project.cardTitle}`}
                      >
                        <img
                          src={project.image}
                          alt={project.cardTitle}
                          class="project-preview-img"
                          loading="lazy"
                        />
                      </a>
                    </div>

                    <div class="project-info">
                      <h3 class="project-title">
                        <a href={`/projets/${project.slug}`}>
                          {project.cardTitle}
                        </a>
                      </h3>
                      <p class="project-desc">{project.description}</p>
                    </div>
                  </div>

                  <div class="project-footer">
                    <span class="project-tech">{project.tech}</span>
                    <a
                      href={`/projets/${project.slug}`}
                      class="project-link"
                    >
                      <span>Découvrir</span>
                      <svg
                        viewBox="0 0 16 16"
                        fill="none"
                        class="project-link-arrow"
                        aria-hidden="true"
                      >
                        <path
                          d="M4.5 11.5L11.5 4.5M11.5 4.5H6M11.5 4.5V10"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  const projectsSection = document.getElementById('decouvrir');
  const scrollTrigger = document.querySelector<HTMLAnchorElement>('.scroll-chevrons');

  if (projectsSection) {
    const revealProjects = () => {
      projectsSection.classList.add('is-visible');
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            revealProjects();
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12 }
    );
    observer.observe(projectsSection);

    if (
      window.location.hash === '#decouvrir' ||
      projectsSection.getBoundingClientRect().top < window.innerHeight * 0.85
    ) {
      revealProjects();
    }

    scrollTrigger?.addEventListener('click', (event) => {
      event.preventDefault();
      revealProjects();
      projectsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    width: 100%;
    background-color: var(--bg-white);
    overflow: hidden;
  }

  /* Arrière-plan ambiant monochrome */
  .hero-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(0, 0, 0, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(
      ellipse 78% 72% at 50% 48%,
      rgba(0, 0, 0, 0.9) 25%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 78% 72% at 50% 48%,
      rgba(0, 0, 0, 0.9) 25%,
      transparent 100%
    );
  }

  .ambient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
  }

  .ambient-orb-left {
    width: clamp(320px, 38vw, 520px);
    height: clamp(320px, 38vw, 520px);
    top: 12%;
    left: 6%;
    background: radial-gradient(
      circle,
      rgba(0, 0, 0, 0.09) 0%,
      rgba(0, 0, 0, 0.03) 50%,
      transparent 75%
    );
  }

  .ambient-orb-right {
    width: clamp(280px, 32vw, 440px);
    height: clamp(280px, 32vw, 440px);
    bottom: 8%;
    right: 8%;
    background: radial-gradient(
      circle,
      rgba(0, 0, 0, 0.07) 0%,
      rgba(180, 180, 190, 0.08) 45%,
      transparent 75%
    );
  }

  /* Conteneur global */
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 100dvh;
    padding: clamp(1.5rem, 3.2vw, 2.75rem) clamp(1.75rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* Scène principale */
  .hero-stage {
    max-width: 1220px;
    width: 100%;
    margin: 0 auto;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    gap: 2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(280px, 420px) minmax(0, auto);
    align-items: center;
    justify-content: center;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    gap: clamp(2.5rem, 6.5vw, 6.5rem);
  }

  /* Gauche : Photo portrait */
  .photo-column {
    display: flex;
    justify-content: center;
  }

  .photo-frame {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 4 / 4.5;
    border-radius: 28px;
    overflow: hidden;
    animation: apple-photo-reveal 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;
  }

  .portrait-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Droite : Titre, sous-titre et liens */
  .content-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    font-size: clamp(3rem, 6.2vw, 5.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .hero-title span:nth-child(1) {
    animation: apple-reveal-up 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both;
  }

  .hero-title span:nth-child(2) {
    animation: apple-reveal-up 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.32s both;
  }

  .role-label {
    font-size: clamp(1.125rem, 1.55vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--text-primary);
    margin-bottom: 1.15rem;
    animation: apple-reveal-up 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.38s both;
  }

  .hero-description {
    font-size: clamp(0.95rem, 1.2vw, 1.0625rem);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    max-width: 54ch;
    margin-bottom: 1.65rem;
    animation: apple-reveal-up 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.44s both;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    animation: apple-reveal-up 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.56s both;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #515154;
    transition: color 0.2s ease;
  }

  .icon-link:hover {
    color: #000000;
  }

  .icon-link:focus-visible,
  .email-link:focus-visible,
  .scroll-chevrons:focus-visible,
  .project-preview-media:focus-visible,
  .project-title a:focus-visible,
  .project-link:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .social-icon {
    width: 26px;
    height: 26px;
    display: block;
  }

  .email-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 0.96875rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #515154;
    margin-left: 0.35rem;
    padding: 0.15rem 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .email-link:hover {
    color: #000000;
  }

  .copy-feedback {
    font-size: 0.78rem;
    font-weight: 500;
    color: #000000;
    opacity: 0;
    transform: translateY(2px);
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .email-link.copied .copy-feedback {
    opacity: 1;
    transform: translateY(0);
  }

  /* Bas de page : flèche centrée sur la page */
  .hero-bottom {
    min-height: 2.5rem;
    padding-bottom: 0.25rem;
  }

  .scroll-chevrons {
    position: absolute;
    left: 50%;
    bottom: calc(clamp(1.5rem, 3.2vw, 2.75rem) + 0.35rem);
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    color: var(--text-tertiary);
    transition: color 0.2s ease;
    animation: apple-reveal-up 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.68s both;
  }

  .scroll-chevrons:hover {
    color: #000000;
  }

  .chevron-icon {
    width: 26px;
    height: 15px;
    display: block;
  }

  /* Section Projets */
  .projects-section {
    position: relative;
    min-height: 100dvh;
    width: 100%;
    background-color: var(--bg-white);
    overflow: hidden;
  }

  .projects-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .ambient-orb-projects-left {
    width: clamp(320px, 38vw, 520px);
    height: clamp(320px, 38vw, 520px);
    top: 18%;
    left: 12%;
    background: radial-gradient(
      circle,
      rgba(0, 0, 0, 0.085) 0%,
      rgba(0, 0, 0, 0.025) 52%,
      transparent 75%
    );
  }

  .ambient-orb-projects-right {
    width: clamp(300px, 34vw, 480px);
    height: clamp(300px, 34vw, 480px);
    bottom: 10%;
    right: 6%;
    background: radial-gradient(
      circle,
      rgba(0, 0, 0, 0.075) 0%,
      rgba(180, 180, 190, 0.08) 48%,
      transparent 75%
    );
  }

  .projects-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 100dvh;
    padding: clamp(2rem, 4.5vw, 3.5rem) clamp(1.75rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .projects-stage {
    max-width: 1220px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .projects-header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .section-title {
    font-size: clamp(2.25rem, 4.4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.06;
    color: var(--text-primary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.2vw, 2rem);
  }

  .project-card {
    border-radius: 28px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .project-card-body,
  .project-footer {
    position: relative;
    z-index: 2;
  }

  .project-card-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .project-preview {
    border-radius: 18px;
    background: linear-gradient(
      160deg,
      rgba(245, 245, 247, 0.92) 0%,
      rgba(235, 235, 239, 0.65) 100%
    );
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.9);
    padding: 0.85rem 0.95rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    overflow: hidden;
  }

  .project-preview-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-tertiary);
  }

  .project-preview-media {
    display: block;
    aspect-ratio: 16 / 10;
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.06);
    background-color: var(--bg-white);
  }

  .project-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-card:hover .project-preview-img {
    transform: scale(1.025);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0 0.2rem;
  }

  .project-title {
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  .project-desc {
    font-size: 0.9375rem;
    line-height: 1.55;
    letter-spacing: -0.008em;
    color: var(--text-secondary);
  }

  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.95rem 0.2rem 0.15rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .project-tech {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--text-tertiary);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #515154;
    transition: color 0.2s ease;
  }

  .project-link:hover {
    color: #000000;
  }

  .project-link-arrow {
    width: 14px;
    height: 14px;
  }

  /* Transition d'apparition style Apple au scroll */
  .projects-section .reveal-item,
  .projects-section .project-card {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(10px);
    transition:
      opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.05s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.95s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .projects-section .project-card {
    transform: translateY(28px) scale(0.96);
  }

  .projects-section.is-visible .reveal-item,
  .projects-section.is-visible .project-card {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  .projects-section.is-visible .projects-header.reveal-item {
    transition-delay: 0.08s;
  }

  .projects-section.is-visible .project-card:nth-child(1) {
    transition-delay: 0.16s;
  }

  .projects-section.is-visible .project-card:nth-child(2) {
    transition-delay: 0.24s;
  }

  .projects-section.is-visible .project-card:nth-child(3) {
    transition-delay: 0.32s;
  }

  .projects-section.is-visible .project-card:nth-child(4) {
    transition-delay: 0.4s;
  }

  .projects-section.is-visible .project-card:nth-child(5) {
    transition-delay: 0.48s;
  }

  .projects-section.is-visible .project-card:nth-child(6) {
    transition-delay: 0.56s;
  }

  @keyframes apple-reveal-up {
    from {
      opacity: 0;
      transform: translateY(22px);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes apple-photo-reveal {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(18px);
      filter: blur(12px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
  }

  /* Responsive tablette et mobile */
  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(240px, 320px) minmax(0, auto);
      gap: clamp(2rem, 5vw, 3.5rem);
    }
  }

  @media (max-width: 768px) {
    .hero-inner,
    .projects-inner {
      padding: 1.5rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .photo-column {
      justify-content: center;
    }

    .content-column {
      align-items: center;
    }

    .hero-title {
      align-items: center;
    }

    .hero-links {
      justify-content: center;
    }

    .photo-frame {
      max-width: 280px;
      border-radius: 24px;
    }

    .hero-bottom {
      padding-top: 0.75rem;
    }

    .scroll-chevrons {
      bottom: 1.65rem;
    }
  }

  @media (max-width: 480px) {
    .photo-frame {
      max-width: 230px;
    }

    .email-link {
      margin-left: 0;
      flex-basis: 100%;
      justify-content: center;
    }
  }
</style>

---
import type { SectionBlock } from '../data/projects';
import RichText from './RichText.astro';

interface Props {
  blocks: SectionBlock[];
}

const { blocks } = Astro.props;
---

<div class="block-stack">
  {
    blocks.map((block) => {
      if (block.type === 'heading') {
        const Tag = block.level === 3 ? 'h3' : 'h2';
        return (
          <Tag class={block.level === 3 ? 'block-h3' : 'block-h2'}>
            {block.text}
          </Tag>
        );
      }

      if (block.type === 'paragraph') {
        return (
          <p class="block-paragraph">
            <RichText text={block.text} />
          </p>
        );
      }

      if (block.type === 'bullets') {
        return (
          <ul class="block-bullets">
            {block.items.map((item) => (
              <li>
                <RichText text={item} />
              </li>
            ))}
          </ul>
        );
      }

      if (block.type === 'cards-list') {
        return (
          <ul class="challenge-list">
            {block.items.map((item) => (
              <li class="challenge-card liquid-glass">
                <strong class="challenge-title">{item.title}</strong>
                <p class="challenge-text">
                  <RichText text={item.text} />
                </p>
              </li>
            ))}
          </ul>
        );
      }

      if (block.type === 'image') {
        return (
          <figure class="block-figure">
            <div
              class="block-image-frame liquid-glass"
              style={block.maxWidth ? `max-width: ${block.maxWidth}; margin-inline: auto;` : undefined}
            >
              <img
                src={block.src}
                alt={block.alt}
                class:list={['block-image', { 'block-image-contrast': block.contrast }]}
                loading="lazy"
              />
            </div>
            {block.caption && (
              <figcaption class="block-caption">{block.caption}</figcaption>
            )}
          </figure>
        );
      }

      if (block.type === 'code') {
        return (
          <figure class="block-figure">
            <pre class="block-code"><code>{block.code}</code></pre>
            {block.caption && (
              <figcaption class="block-caption">{block.caption}</figcaption>
            )}
          </figure>
        );
      }

      if (block.type === 'stats') {
        return (
          <div class="block-figure">
            <div class="stats-grid">
              {block.items.map((stat) => (
                <div class="stat-card liquid-glass">
                  <div class="stat-score">{stat.score}</div>
                  <div class="stat-label">{stat.label}</div>
                </div>
              ))}
            </div>
            {block.caption && <p class="block-caption">{block.caption}</p>}
          </div>
        );
      }

      return null;
    })
  }
</div>

<style>
  .block-stack {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .block-h2 {
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--text-primary);
  }

  .block-h3 {
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text-primary);
    margin-top: 0.45rem;
  }

  .block-paragraph {
    font-size: 1rem;
    line-height: 1.65;
    letter-spacing: -0.008em;
    color: var(--text-secondary);
  }

  .block-paragraph :global(strong),
  .block-bullets :global(strong),
  .challenge-text :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .block-paragraph :global(code),
  .block-bullets :global(code),
  .challenge-text :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875em;
    padding: 0.12rem 0.4rem;
    border-radius: 6px;
    background-color: var(--bg-muted);
    color: var(--text-primary);
  }

  .block-paragraph :global(.rich-link),
  .block-bullets :global(.rich-link),
  .challenge-text :global(.rich-link) {
    color: var(--text-primary);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(0, 0, 0, 0.25);
    transition: text-decoration-color 0.2s ease;
  }

  .block-paragraph :global(.rich-link:hover),
  .block-bullets :global(.rich-link:hover),
  .challenge-text :global(.rich-link:hover) {
    text-decoration-color: var(--text-primary);
  }

  .block-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .block-bullets li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.96875rem;
    line-height: 1.6;
    letter-spacing: -0.008em;
    color: var(--text-secondary);
  }

  .block-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--text-primary);
  }

  .challenge-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .challenge-card {
    border-radius: 18px;
    padding: 1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .challenge-title,
  .challenge-text {
    position: relative;
    z-index: 2;
  }

  .challenge-title {
    font-size: 0.96875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  .challenge-text {
    font-size: 0.925rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .block-figure {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .block-image-frame {
    border-radius: 22px;
    padding: 0.65rem;
    width: 100%;
  }

  .block-image {
    position: relative;
    z-index: 2;
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .block-image-contrast {
    filter: contrast(1.25);
  }

  .block-caption {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-tertiary);
    text-align: center;
  }

  .block-code {
    margin: 0;
    padding: 1.35rem 1.5rem;
    border-radius: 20px;
    background-color: #111114;
    color: #f5f5f7;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 44px -16px rgba(0, 0, 0, 0.24);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    gap: 1rem;
  }

  .stat-card {
    border-radius: 22px;
    padding: 1.35rem 1.1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.3rem;
  }

  .stat-score,
  .stat-label {
    position: relative;
    z-index: 2;
  }

  .stat-score {
    font-size: clamp(1.65rem, 2.6vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-tertiary);
  }
</style>
